{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "baseBranchPatterns": ["dev"],
  "enabledManagers": ["dockerfile", "docker-compose", "github-actions", "npm"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major"
    },
    {
      "description": "Bump CI's Node and the build image's Node in one PR, so tests and the image never use different versions",
      "matchManagers": ["github-actions", "dockerfile"],
      "matchDepNames": ["node"],
      "groupName": "node toolchain"
    }
  ]
}
